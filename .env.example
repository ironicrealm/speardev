# Copy this file to .env and fill it in. Never upload .env anywhere.

# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=
# Your Discord server ID (right-click the server -> Copy Server ID)
GUILD_ID=

# Channel where the Verify / Apply buttons are posted
APPLY_CHANNEL_ID=
# Private staff channel where applications show up for review
REVIEW_CHANNEL_ID=
# Optional: channel for a log of accepts/denies
LOG_CHANNEL_ID=

# Roblox Open Cloud API key (needs group read + write for the Spearhead group)
ROBLOX_API_KEY=
